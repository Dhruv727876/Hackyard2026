# Server-only. Never prefix with VITE_ — that would bundle the key into the client.
# Get a key from https://build.nvidia.com
# If left blank, scans fall back to realistic sample data.
NVIDIA_API_KEY=

# Optional client-side model override (not a secret).
VITE_NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
